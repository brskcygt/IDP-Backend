{
  "name": "idp-runner-cloud",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply idp-runner-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply idp-runner-db --remote",
    "keys:generate": "node scripts/generate-job-signing-key.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
