# Agent listener: Java agent'ların bağlandığı dış port. Cloudflare tüneli YALNIZCA buraya yönlenir.
# Bu portta sadece kimliği doğrulanmış agent WebSocket'i ve sayısız GET /health vardır.
IDP_AGENT_GATEWAY_HOST=0.0.0.0
IDP_AGENT_GATEWAY_PORT=7003

# Kontrol listener: backend REST uçları, agent kimlik yönetimi ve abonelik WebSocket'i.
# Loopback'te bırakın; tünele veya dış ağa açmayın.
IDP_AGENT_GATEWAY_CONTROL_HOST=127.0.0.1
IDP_AGENT_GATEWAY_CONTROL_PORT=7004

# YALNIZCA kontrol API token'ı (backend'deki IDP_AGENT_API_TOKEN ile aynı değer).
# Boşsa gateway başlamaz. Agent JAR'larına VERİLMEZ; agent listener bu token'ı kabul etmez.
IDP_AGENT_API_TOKEN=

# İsteğe bağlı: agent kayıt dosyası (varsayılan ./data/agents.json). Kimlik hash'lerini içerir.
# IDP_AGENT_REGISTRY_PATH=
