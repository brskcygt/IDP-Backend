# =============================================================
# IDP - Internal Developer Platform
# Environment Variables Configuration
# =============================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Session / Auth (T-11 / SEC-04) ----
# Signs the express-session cookie. If unset, the server generates a random
# secret at startup instead of blocking (see T-38/T-13), but every session
# is dropped on the next restart — set this for anything beyond local dev.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: sets the bootstrap admin password on first run instead of
# generating a random one and printing it once to the console. Useful for
# CI/automation. Only read the very first time backend/src/users.json is
# created — has no effect once that file exists.
# IDP_ADMIN_PASSWORD=

# ---- Jenkins ----
JENKINS_URL=http://jenkins.local:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token_here

# ---- SSH (Remote Server Deployment) ----
SSH_HOST=10.0.0.1
SSH_PORT=22
SSH_USER=deployer
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSWORD=  # Optional: Use only if private key is not available

# ---- PMP (Web Portal Automation) ----
PMP_URL=https://pmp.internal.company.com
PMP_USER=portal_admin
PMP_PASSWORD=your_pmp_password_here
PMP_TIMEOUT_MS=30000

# ---- MFA Webhook ----
# Shared secret for POST /api/mfa/webhook-otp. The SMS-forwarding client must send
# this as `apiKey` in the request body. Currently the check is skipped when the field
# is absent — see SEC-05 / T-13, which makes it mandatory.
MFA_WEBHOOK_API_KEY=change_me_to_a_long_random_value

# ---- Secret Storage (T-10 / SEC-01) ----
# Base64-encoded 32-byte AES-256 key used by SecretStore (backend/src/secrets)
# to encrypt credentials at rest instead of storing them in plaintext.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, SecretStore.createSecretStore() returns null and secret storage
# is disabled — keep this out of version control once set in your real .env.
IDP_SECRET_KEY=

# ---- Logging ----
LOG_LEVEL=info

# NOTE: No provider variable above is required to start the server. They are only
# fallback defaults — every project supplies its own configuration from the UI.
# Existing company updater-agent backend (HTTP and WebSocket share the same origin).
IDP_AGENT_API_URL=http://127.0.0.1:7003
# Optional when the existing backend protects agent routes/WebSocket upgrades.
IDP_AGENT_API_TOKEN=
