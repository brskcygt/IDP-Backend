# =============================================================
# IDP - Internal Developer Platform
# Environment Variables Configuration
# =============================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================

# ---- Server ----
PORT=3001
NODE_ENV=development

# Dinlenecek adres (opsiyonel). Boşsa tüm arayüzlerde dinler (eski davranış).
# Sunucuda iç ağ IP'si ya da 0.0.0.0; sadece yerel test için 127.0.0.1.
# IDP_HOST=

# Oturum cookie'sinin Secure bayrağı (opsiyonel, sadece true / false).
# Boşsa: NODE_ENV=production iken true, aksi halde false (eski davranış).
# Secure cookie düz HTTP üzerinden GÖNDERİLMEZ; TLS'siz iç ağ kurulumunda
# production'da false yapın, yoksa giriş çalışmaz. production + false açılışta
# uyarı basar: sadece güvenilir iç ağda kullanın. Başka bir değer açılışı durdurur.
# IDP_COOKIE_SECURE=

# Sağlık kontrolü: GET /api/health (auth'suz) -> {"ok":true,"service":"idp-backend",...}

# ---- Session / Auth (T-11 / SEC-04) ----
# Signs the express-session cookie.
# NODE_ENV=production iken ZORUNLU: boşsa sunucu açılmaz.
# Development'ta boşsa her açılışta rastgele üretilir ve restart'ta tüm oturumlar düşer.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: sets the bootstrap admin password on first run instead of
# generating a random one and printing it once to the console. Useful for
# CI/automation. Only read the very first time the users file (IDP_USERS_PATH)
# is created — has no effect once that file exists.
# IDP_ADMIN_PASSWORD=

# ---- Veri dosyaları (opsiyonel yollar) ----
# Boşsa backend/src/ altındaki varsayılanlar kullanılır. Sunucu kurulumunda kod
# dizininin DIŞINDA bir veri klasörü verin (güncelleme backend/'i değiştirince
# veri gitmesin) ve o klasörü yedekleyin. Mutlak yol kullanın,
# Windows'ta örn. C:\IDP\data\idp.db
# SQLite veritabanı (varsayılan: backend/src/idp.db)
# IDP_DB_PATH=
# Kullanıcı hesapları (varsayılan: backend/src/users.json)
# IDP_USERS_PATH=
# Oturum deposu (varsayılan: backend/src/sessions.json)
# IDP_SESSIONS_PATH=
# Şifreli secret deposu (varsayılan: backend/src/secrets.enc.json).
# Klasör yoksa ilk yazımda oluşturulur; dosya 0600 izniyle yazılır.
# IDP_SECRETS_PATH=

# ---- Jenkins ----
JENKINS_URL=http://jenkins.local:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token_here

# ---- SSH (Remote Server Deployment) ----
SSH_HOST=10.0.0.1
SSH_PORT=22
SSH_USER=deployer
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSWORD=  # Optional: Use only if private key is not available

# ---- PMP (Web Portal Automation) ----
PMP_URL=https://pmp.internal.company.com
PMP_USER=portal_admin
PMP_PASSWORD=your_pmp_password_here
PMP_TIMEOUT_MS=30000

# ---- MFA Webhook ----
# Shared secret for POST /api/mfa/webhook-otp. The SMS-forwarding client must send
# this as `apiKey` in the request body. Currently the check is skipped when the field
# is absent — see SEC-05 / T-13, which makes it mandatory.
MFA_WEBHOOK_API_KEY=change_me_to_a_long_random_value

# ---- Secret Storage (T-10 / SEC-01) ----
# Proje credential'larını (şifre, token) diskte AES-256-GCM ile şifreleyen anahtar.
# Format: base64 kodlanmış TAM 32 bayt (44 karakter, sonu "="). Başka uzunluk
# geçersizdir (backend/src/secrets/keyManager.js).
# Üret (Node):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Üret (PowerShell 5.1+):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# UYARI: Bu anahtar kaybolur ya da değişirse secret deposundaki TÜM secret'lar
# geri dönüşsüz okunamaz olur. Anahtarı secrets dosyasından AYRI, güvenli bir
# yerde yedekleyin; secrets dosyasını da ayrıca yedekleyin.
# Boşsa secret deposu kapalıdır ve credential'lar düz metin kalır.
IDP_SECRET_KEY=

# ---- Logging ----
LOG_LEVEL=info

# NOTE: No provider variable above is required to start the server. They are only
# fallback defaults — every project supplies its own configuration from the UI.

# ---- IDP agent gateway ----
# Gateway'in KONTROL dinleyicisi (yalnızca 127.0.0.1, varsayılan 7004): backend'in
# HTTP çağrıları ve canlı log aboneliği (WebSocket) buradan gider. Agent'lar bu
# porta bağlanmaz, agent dinleyicisine (7003) bağlanır. Kontrol portu firewall'da
# açılmaz ve Cloudflare tüneline ASLA eklenmez.
IDP_AGENT_API_URL=http://127.0.0.1:7004
# Kontrol token'ı: gateway'deki IDP_AGENT_API_TOKEN ile AYNI değer. Artık agent'lara
# verilmez (her agent kendi kimliğini taşır). Gateway bu değer boşken açılmaz.
IDP_AGENT_API_TOKEN=

# Agent'ların dışarıdan bağlanacağı adres. Agent kimliği üretilirken
# (POST /api/agents/:id/credentials) agent paketine yazılır; ws:// ya da wss:// olmalı.
# Boşsa veya geçersizse kimlik üretimi 503 döner (sunucu yine açılır).
# İnternetten erişim: wss://agent.<alan>    İç ağ: ws://<sunucu-ip>:7003
# Bkz. deploy/agent-public-endpoint.md
# IDP_AGENT_PUBLIC_URL=

# Cloudflare Access service token (opsiyonel; yalnızca agent ucunun önünde Cloudflare
# proxy/Access varsa). Değerler agent paketine gömülür. İKİSİ BİRLİKTE ya da hiçbiri:
# yalnızca biri doluysa backend açılmaz.
# IDP_AGENT_CF_ACCESS_CLIENT_ID=
# IDP_AGENT_CF_ACCESS_CLIENT_SECRET=

# ---- Cloudflare runner (opsiyonel) ----
# Projede runner API adresi/anahtarı girilmemişse kullanılan varsayılanlar.
# URL boşsa koddaki varsayılan workers.dev adresi kullanılır.
# IDP_RUNNER_API_URL=
# Runner yönetici API anahtarı (Bearer olarak gönderilir).
# IDP_RUNNER_ADMIN_API_KEY=
